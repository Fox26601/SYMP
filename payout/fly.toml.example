# Example Fly.io config for self-hosting the payout API.
# Copy to fly.toml (gitignored) and replace placeholders.
# Do not commit real app names or production defaults to a public tree.

app = "symp-payout-example"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  HTTP_ADDR = ":8088"
  SQLITE_PATH = "/data/payout.db"
  ONCHAIN_CHAIN_ID = "84532"
  MAX_PAYOUT_USD = "500"
  DAILY_LIMIT_USD = "2000"
  SLIPPAGE_BPS = "100"

[http_service]
  internal_port = 8088
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "10s"
    method = "GET"
    path = "/health"

[mounts]
  source = "symp_payout_data"
  destination = "/data"
